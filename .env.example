# VisionX Backend Environment Configuration (server.py)

# Cloudflare Tunnel / Gateway Domain Endpoint
VISIONX_ENDPOINT_URL=https://visionx.my.id/api/upload

# Supabase Auth Configuration
# Project URL dari dashboard Supabase Anda (misal: https://xyzcompany.supabase.co)
SUPABASE_URL=https://wnwaniiuflsuemyambuy.supabase.co

# Supabase JWT Secret (didapat dari: Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# JWT Audience (default Supabase: 'authenticated')
SUPABASE_AUDIENCE=authenticated

# Rate Limiting: Batas pesan chat harian untuk role 'user' (role 'developer' tidak terbatas)
VISIONX_USER_DAILY_CHAT_LIMIT=30

# Fitur Legacy PIN: 0 = non-aktif (murni Supabase Auth), 1 = aktifkan fallback PIN lama
VISIONX_LEGACY_PIN=0

# AI Provider Configuration (OpenAI-compatible / Groq Cloud untuk /api/chat)
# Base URL endpoint OpenAI-compatible provider (Groq Cloud)
AI_BASE_URL=https://api.groq.com/openai/v1
# API Key untuk autentikasi ke Groq Cloud
AI_API_KEY=your_groq_api_key_here
# Nama model default (default: llama-3.3-70b-versatile, otomatis fallback jika model tidak tersedia)
AI_MODEL=llama-3.3-70b-versatile

# Server Port & Storage Dir
PORT=5000
VISIONX_DATASET_DIR=/sdcard/AI-Detector

